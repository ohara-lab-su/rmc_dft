{
  "description": "Qn-network settings for Si-O-Si silica glass. The rmc_top section is for RMC_POT FNC=4 topology, not for GROMACS MD.",
  "atom_types": ["Si", "O"],
  "hard_sphere_cutoffs": {
    "Si-Si": 2.40,
    "Si-O": 1.25,
    "O-O": 2.10
  },
  "qn": {
    "central_types": ["Si"],
    "bridge_types": ["O"],
    "second_types": ["Si"],
    "first_min": 1.20,
    "first_max": 1.90,
    "first_mode": "nearest",
    "first_nearest_n": 4,
    "second_min": 1.20,
    "second_max": 1.90,
    "second_use_first_network": true
  },
  "fnc3": {
    "constraints": [
      {
        "type_id": 1,
        "name": "Si-O bond",
        "source": "central_bridge_bonds",
        "rmin": 1.45,
        "rmax": 1.85
      },
      {
        "type_id": 2,
        "name": "Si-Si through O",
        "source": "central_second_through_bridge",
        "rmin": 2.40,
        "rmax": 3.50
      },
      {
        "type_id": 3,
        "name": "O-O around Si",
        "source": "bridge_bridge_around_central",
        "rmin": 2.10,
        "rmax": 3.40
      }
    ]
  },
  "rmc_top": {
    "molecule_name": "SIO2NET",
    "residue_name": "SIO2",
    "nrexcl": 2,
    "bond": {
      "length_nm": 0.161,
      "force_kj_mol_nm2": 10000.0,
      "sigma": 10.0
    },
    "angles": [
      {
        "name": "O-Si-O",
        "source": "bridge_central_bridge",
        "theta_degree": 109.47,
        "force_kj_mol_rad2": 100.0,
        "sigma": 10.0
      },
      {
        "name": "Si-O-Si",
        "source": "central_bridge_second",
        "theta_degree": 144.0,
        "force_kj_mol_rad2": 30.0,
        "sigma": 20.0
      }
    ]
  }
}
